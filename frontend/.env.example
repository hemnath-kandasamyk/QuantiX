# Firebase config, used only for "Sign in with Google" (src/lib/firebase.ts).
# Get these from the Firebase console: Project settings > General > Your apps.
# If left unset, firebase.ts falls back to placeholder demo values and Google
# sign-in will not work.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Optional: override where /api requests are proxied to in dev
# (see vite.config.ts). Defaults to http://localhost:4000.
VITE_API_PROXY_TARGET=http://localhost:4000

# Production only: absolute URL of the deployed backend, needed whenever
# frontend and backend are NOT on the same origin (e.g. Vercel + Render).
# Leave unset in local dev — the proxy above handles it instead.
# VITE_API_URL=https://your-backend.onrender.com/api
