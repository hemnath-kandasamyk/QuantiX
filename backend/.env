PORT=4000
JWT_SECRET=replace-this-with-a-long-random-string

# Optional - wire these into src/routes/ai.js to use a real LLM instead of
# the built-in rule-based assistant.
OPENAI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# xAI Grok - if set, the AI assistant uses Grok instead of the local
# rule-based engine (falls back automatically if the call fails).
XAI_API_KEY=
XAI_MODEL=grok-4.5

# Optional - payment gateway (billing page currently records "cash"/"card"
# as a label only; wire this up in routes/sales.js to actually charge)
STRIPE_SECRET_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional - email/SMS alert delivery
SENDGRID_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

